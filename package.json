{
  "name": "@tishlang/sem",
  "version": "1.3.1",
  "description": "Automated semantic versioning and release pipeline — a semantic-release clone written in Tish (dual-runtime: Tish + Node)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tishlang/sem.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "tish": {
    "module": "src/index.tish"
  },
  "main": "dist/sem.js",
  "module": "dist/sem.js",
  "exports": {
    ".": {
      "tish": "./src/index.tish",
      "import": "./dist/sem.js",
      "default": "./dist/sem.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sem": "dist/cli.js"
  },
  "files": [
    "src/",
    "dist/",
    "action.yml",
    "README.md",
    "LICENSE",
    "docs/",
    "scripts/build.sh"
  ],
  "scripts": {
    "start": "npm run release",
    "release": "npm run build && node dist/cli.js",
    "release:dry": "npm run build && node dist/cli.js --dry-run",
    "build": "bash scripts/build.sh",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "tish run --feature fs,process,regex test/semver.test.tish && tish run --feature fs,process,regex test/commit-parser.test.tish && tish run --feature fs,process,regex test/commit-analyzer.test.tish && tish run --feature fs,process,regex test/release-notes.test.tish && tish run --feature fs,process,regex test/yaml.test.tish",
    "test:integration": "tish run --feature full test/integration.test.tish",
    "test:node": "npm run build && node dist/cli.js --help && node dist/cli.js --version",
    "test:all": "npm test && npm run test:integration && npm run test:node"
  },
  "keywords": [
    "semantic-release",
    "release",
    "semver",
    "conventional-commits",
    "changelog",
    "automation",
    "tish",
    "github-actions"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@tishlang/tish": "3.3.3"
  },
  "sem": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@sem/commit-analyzer",
      "@sem/release-notes-generator",
      "@sem/changelog",
      [
        "@sem/npm",
        {
          "npmPublish": true
        }
      ],
      "@sem/github",
      "@sem/git"
    ]
  }
}
