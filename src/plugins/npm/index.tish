// sem/src/plugins/npm/index.tish
// Clone of @semantic-release/npm
// Updates package.json version and publishes to npm registry

import { readFile, writeFile, fileExists, execCapture } from "../../host.tish"

// True when name@version is already on the registry
export fn npmHasVersion(name, version) {
  if (name === null || version === null || version === "") return false
  let spec = name + "@" + version
  let result = execCapture("npm view " + JSON.stringify(spec) + " version")
  if (result.code !== 0) return false
  let out = result.stdout !== null ? result.stdout.trim() : ""
  return out === version
}

// For the orchestrator's republish recovery: is `version` missing from npm? False when publishing
// is off or the package is private, since then nothing would be published anyway.
export fn npmMissingVersion(pluginConfig, cwd, version) {
  if (pluginConfig.npmPublish === false) return false
  let pkgRoot = pluginConfig.pkgRoot !== null ? pluginConfig.pkgRoot : "."
  let pkgPath = `${cwd}/${pkgRoot}/package.json`
  if (!fileExists(pkgPath)) return false
  let pkg = JSON.parse(readFile(pkgPath))
  if (pkg.private === true || pkg.name === null) return false
  return !npmHasVersion(pkg.name, version)
}

// verifyConditions — check npm auth
export fn npmVerifyConditions(pluginConfig, context) {
  let logger = context.logger
  let env = context.env

  let npmPublish = pluginConfig.npmPublish !== null ? pluginConfig.npmPublish : true
  if (!npmPublish) {
    logger.info("npm publish is disabled")
    return null
  }

  // Check for NPM_TOKEN, then OIDC trusted publishing, then an existing npm login
  let token = env.NPM_TOKEN
  let oidc = env.ACTIONS_ID_TOKEN_REQUEST_URL !== null && env.ACTIONS_ID_TOKEN_REQUEST_URL !== ""
  if ((token === null || token === "") && oidc) {
    // npm (>= 11.5.1) exchanges the job's OIDC token at publish time; `npm whoami` cannot see it.
    logger.info("Using npm OIDC trusted publishing (id-token: write)")
  } else if (token === null || token === "") {
    // Try .npmrc or npm whoami
    let result = execCapture(`cd "${context.cwd}" && npm whoami`)
    if (result.code !== 0) {
      throw "npm authentication failed. Set NPM_TOKEN, grant the job id-token: write for OIDC trusted publishing, or run 'npm login'."
    }
    logger.info(`Authenticated as: ${result.stdout.trim()}`)
  } else {
    logger.info("NPM_TOKEN is set")
  }

  // Verify package.json exists
  let pkgRoot = pluginConfig.pkgRoot !== null ? pluginConfig.pkgRoot : "."
  let pkgPath = `${context.cwd}/${pkgRoot}/package.json`
  if (!fileExists(pkgPath)) {
    throw `Cannot find package.json at ${pkgPath}`
  }
  let content = readFile(pkgPath)
  let pkg = JSON.parse(content)
  if (pkg.name === null) {
    throw "package.json is missing 'name' field"
  }
  logger.info(`Package: ${pkg.name}`)

  // Check if private
  if (pkg.private === true) {
    logger.warn("Package is marked as private — npm publish will be skipped")
  }

  return null
}

// prepare — update version in package.json
export fn npmPrepare(pluginConfig, context) {
  let logger = context.logger
  let version = context.nextRelease.version
  let pkgRoot = pluginConfig.pkgRoot !== null ? pluginConfig.pkgRoot : "."
  let cwd = context.cwd

  // Update package.json
  let pkgPath = `${cwd}/${pkgRoot}/package.json`
  let content = readFile(pkgPath)
  let pkg = JSON.parse(content)
  pkg.version = version
  writeFile(pkgPath, JSON.stringify(pkg, null, 2) + "\n")
  logger.success(`Updated package.json version to ${version}`)

  // Update package-lock.json if it exists
  let lockPath = `${cwd}/${pkgRoot}/package-lock.json`
  if (fileExists(lockPath)) {
    let lockContent = readFile(lockPath)
    let lock = JSON.parse(lockContent)
    lock.version = version
    if (lock.packages !== null && lock.packages[""] !== null) {
      lock.packages[""].version = version
    }
    writeFile(lockPath, JSON.stringify(lock, null, 2) + "\n")
    logger.success("Updated package-lock.json version")
  } else {
    logger.debug("No package-lock.json to update")
  }

  return null
}

// publish — run npm publish
export fn npmPublish(pluginConfig, context) {
  let logger = context.logger
  let npmPublish = pluginConfig.npmPublish !== null ? pluginConfig.npmPublish : true
  let pkgRoot = pluginConfig.pkgRoot !== null ? pluginConfig.pkgRoot : "."
  let cwd = context.cwd

  // Read package.json to check if private
  let pkgPath = `${cwd}/${pkgRoot}/package.json`
  let content = readFile(pkgPath)
  let pkg = JSON.parse(content)

  if (pkg.private === true) {
    logger.info("Package is private, skipping npm publish")
    return null
  }

  if (!npmPublish) {
    logger.info("npm publish is disabled via config")
    return null
  }

  if (context.options.dryRun) {
    logger.info(`[dry-run] Would publish ${pkg.name}@${context.nextRelease.version}`)
    return {
      name: "npm",
      url: `https://www.npmjs.com/package/${pkg.name}/v/${context.nextRelease.version}`
    }
  }

  // A re-run resumes: a version npm already has is skipped rather than failing the release.
  if (npmHasVersion(pkg.name, context.nextRelease.version)) {
    logger.info(`Skipping ${pkg.name}@${context.nextRelease.version} (already on npm)`)
    return {
      name: "npm",
      url: `https://www.npmjs.com/package/${pkg.name}/v/${context.nextRelease.version}`
    }
  }

  // Building is the package's job, not the plugin's: `npm publish` runs the package's own
  // prepack / prepublishOnly scripts. (This used to run `npm run build` and require dist/cli.js,
  // which only fit sem itself and made every other package fail to publish.)
  let publishDir = `${cwd}/${pkgRoot}`

  // Build the publish command
  let cmd = "npm publish --access public"

  // Add dist-tag for channels
  let channel = context.nextRelease.channel
  if (channel !== null && channel !== "" && channel !== "latest") {
    cmd = cmd + ` --tag ${channel}`
  }

  // 2FA / automation: NPM_OTP=123456 npm run release
  let env = context.env
  let otp = env.NPM_OTP !== null && env.NPM_OTP !== "" ? env.NPM_OTP : env.npm_config_otp
  if (otp !== null && otp !== "") {
    cmd = cmd + ` --otp ${otp}`
  }

  // Set registry auth via NPM_TOKEN
  if (env.NPM_TOKEN !== null && env.NPM_TOKEN !== "") {
    cmd = `NPM_TOKEN=${env.NPM_TOKEN} ${cmd}`
  }

  let result = execCapture(`cd "${publishDir}" && ${cmd}`)

  if (result.code !== 0) {
    let errMsg = result.stderr !== null ? result.stderr.trim() : "npm publish failed"
    throw `npm publish failed: ${errMsg}`
  }

  logger.success(`Published ${pkg.name}@${context.nextRelease.version} to npm`)

  return {
    name: "npm",
    url: `https://www.npmjs.com/package/${pkg.name}/v/${context.nextRelease.version}`
  }
}

// addChannel — add npm dist-tag
export fn npmAddChannel(pluginConfig, context) {
  let logger = context.logger
  let pkgRoot = pluginConfig.pkgRoot !== null ? pluginConfig.pkgRoot : "."
  let cwd = context.cwd

  let pkgPath = `${cwd}/${pkgRoot}/package.json`
  let content = readFile(pkgPath)
  let pkg = JSON.parse(content)

  let channel = context.nextRelease.channel
  if (channel === null || channel === "") {
    channel = "latest"
  }

  if (context.options.dryRun) {
    logger.info(`[dry-run] Would add dist-tag ${channel} to ${pkg.name}@${context.nextRelease.version}`)
    return null
  }

  let cmd = `npm dist-tag add ${pkg.name}@${context.nextRelease.version} ${channel}`
  let result = execCapture(`cd "${cwd}" && ${cmd}`)

  if (result.code !== 0) {
    logger.warn(`Failed to add dist-tag: ${result.stderr}`)
  } else {
    logger.success(`Added dist-tag ${channel} to ${pkg.name}@${context.nextRelease.version}`)
  }

  return null
}
