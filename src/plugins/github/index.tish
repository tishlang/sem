// sem/src/plugins/github/index.tish
// @sem/github — modular clone of @semantic-release/github
//
// Config (all optional):
//   assets            string | {path,name,label}[]  — upload to the release
//   prerelease         true | false | "channel"     — default "channel" (auto from nextRelease.channel)
//   draftRelease       boolean                      — create as draft
//   targetCommitish    string                       — branch or SHA (tish: release/vX.Y.Z)
//   releaseNameTemplate / releaseBodyTemplate       — ${nextRelease.version} etc.
//   successComment     string | false               — issue/PR comment (false disables)
//   failComment        string | false
//   failTitle          string | false
//   labels             string[] | false             — labels on fail issue
//   assignees          string[]
//   releasedLabels     string[] | false             — labels on resolved issues/PRs
//   githubUrl / githubApiUrl / githubApiPathPrefix  — GHE

import {
  apiUrl,
  githubFetch,
  resolveApiBase,
  getToken,
  getRepoInfo
} from "./api.tish"
import { createOrUpdateRelease, updateReleaseChannel } from "./release.tish"
import { commentSuccess, reportFailure } from "./comments.tish"

// verifyConditions — token + repo API access
export fn githubVerifyConditions(pluginConfig, context) {
  let logger = context.logger
  let env = context.env

  let token = getToken(env)
  if (token === null) {
    throw "GitHub token not found. Set GITHUB_TOKEN or GH_TOKEN (or authenticate `gh`)."
  }

  let repoInfo = getRepoInfo(context)
  if (repoInfo === null) {
    throw "Could not determine repository info from remote URL"
  }

  let apiBase = resolveApiBase(pluginConfig, env)
  let url = apiUrl(apiBase, "/repos/" + repoInfo.owner + "/" + repoInfo.repo)

  try {
    let response = githubFetch(url, "GET", token, null)
    if (response.status === 401 || response.status === 403) {
      throw "GitHub token is invalid or lacks required permissions"
    }
    if (response.status === 404) {
      throw "Repository " + repoInfo.owner + "/" + repoInfo.repo + " not found"
    }
    logger.info("Verified GitHub access for " + repoInfo.owner + "/" + repoInfo.repo)
  } catch (e) {
    throw "GitHub API verification failed: " + String(e)
  }

  return null
}

// publish — create/update release + upload assets
export fn githubPublish(pluginConfig, context) {
  return createOrUpdateRelease(pluginConfig, context)
}

// addChannel — promote/demote prerelease flag when a version is added to a channel
export fn githubAddChannel(pluginConfig, context) {
  return updateReleaseChannel(pluginConfig, context)
}

// success — comment on associated issues and PRs
export fn githubSuccess(pluginConfig, context) {
  return commentSuccess(pluginConfig, context)
}

// fail — open or update a failure issue
export fn githubFail(pluginConfig, context) {
  return reportFailure(pluginConfig, context)
}
