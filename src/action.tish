// sem/src/action.tish
// sem GitHub Action entry — compiled to dist/action.js via tish build

import { loadConfig } from "./config.tish"
import { release } from "./orchestrator.tish"
import { writeGitHubOutputs } from "./github-output.tish"
import { parseDocument } from "./utils/yaml.tish"

fn getInput(name, fallback) {
  let key = "INPUT_" + name.toUpperCase()
  let v = process.env[key]
  if (v === null || v === "") return fallback
  return v
}

fn asBool(value, defaultValue) {
  if (value === null || value === "") return defaultValue
  let s = String(value).trim().toLowerCase()
  return s === "true" || s === "1" || s === "yes" || s === "y" || s === "on"
}

fn parseInputDoc(raw, label) {
  if (raw === null || String(raw).trim() === "") return null
  return parseDocument(raw, label)
}

fn resolvePath(base, rel) {
  let pathMod = null
  if (typeof process.getBuiltinModule === "function") {
    pathMod = process.getBuiltinModule("path")
  }
  if (pathMod !== null) {
    return pathMod.resolve(base, rel)
  }
  // Tish fallback — simple join when already absolute-ish
  if (rel === "." || rel === "") return base
  if (rel.startsWith("/")) return rel
  return base + "/" + rel
}

fn runAction() {
  let workingDirectory = getInput("working_directory", ".")
  if (workingDirectory === null || workingDirectory === "") workingDirectory = "."
  let cwd = resolvePath(process.cwd(), workingDirectory)

  let dryRun = asBool(getInput("dry_run", "false"), false)
  let ci = asBool(getInput("ci", "true"), true)
  let debug = asBool(getInput("debug", "false"), false)

  let configRaw = getInput("config", "")
  let branchesRaw = getInput("branches", "")
  let tagFormat = getInput("tag_format", "")
  let force = getInput("force", "")
  let ignoreBranchesRaw = getInput("ignore_branches", "")

  let cliOverrides = {
    dryRun: dryRun,
    noCi: !ci,
    debug: debug
  }

  if (configRaw !== null && String(configRaw).trim() !== "") {
    cliOverrides.configJson = configRaw
  }
  if (force !== null && String(force).trim() !== "") {
    cliOverrides.force = String(force).trim()
  }

  let config = loadConfig(cwd, cliOverrides)

  let branches = parseInputDoc(branchesRaw, "branches")
  if (branches !== null) {
    config.branches = branches
  }
  let ignoreBranches = parseInputDoc(ignoreBranchesRaw, "ignore_branches")
  if (ignoreBranches === null && ignoreBranchesRaw !== null && String(ignoreBranchesRaw).trim() !== "") {
    // Allow comma-separated string as well as JSON/YAML array
    let parts = String(ignoreBranchesRaw).split(",")
    ignoreBranches = []
    let ii = 0
    while (ii < parts.length) {
      let p = parts[ii].trim()
      if (p !== "") ignoreBranches.push(p)
      ii = ii + 1
    }
  }
  if (ignoreBranches !== null) {
    config.ignoreBranches = ignoreBranches
  }
  if (tagFormat !== null && String(tagFormat).trim() !== "") {
    config.tagFormat = tagFormat
  }

  config.cwd = cwd
  config.dryRun = dryRun
  if (!ci) config.noCi = true
  if (debug) config.debug = true
  if (force !== null && String(force).trim() !== "") {
    config.force = String(force).trim()
  }

  let result = release(config)
  writeGitHubOutputs(result)

  if (!result.success) {
    console.error("sem action failed: " + result.error)
    process.exit(1)
  }

  // Soft success when no bump
  process.exit(0)
}

runAction()
