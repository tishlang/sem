// sem/src/semver.tish
// Full semver 2.0 implementation: parse, format, increment, compare

const SEMVER_RE = /^v?(\d+)\.(\d+)\.(\d+)(?:-([a-zA-Z0-9.]+))?(?:\+([a-zA-Z0-9.]+))?$/

export fn parse(version) {
  if (version === null) return null
  let str = version.trim()
  let m = str.match(SEMVER_RE)
  if (m === null) return null
  return {
    major: parseInt(m[1]),
    minor: parseInt(m[2]),
    patch: parseInt(m[3]),
    prerelease: m[4] !== null ? m[4] : null,
    build: m[5] !== null ? m[5] : null,
    raw: str
  }
}

export fn valid(version) {
  return parse(version) !== null
}

export fn clean(version) {
  if (version === null) return null
  let str = version.trim()
  if (str.startsWith("v")) {
    str = str.slice(1)
  }
  let p = parse(str)
  if (p === null) return null
  return format(p)
}

export fn format(semverObj) {
  let result = `${semverObj.major}.${semverObj.minor}.${semverObj.patch}`
  if (semverObj.prerelease !== null) {
    result = result + `-${semverObj.prerelease}`
  }
  if (semverObj.build !== null) {
    result = result + `+${semverObj.build}`
  }
  return result
}

// Compare prerelease identifiers
fn comparePrereleaseIdentifiers(a, b) {
  if (a === null && b === null) return 0
  // No prerelease > has prerelease (1.0.0 > 1.0.0-alpha)
  if (a === null && b !== null) return 1
  if (a !== null && b === null) return -1

  let partsA = a.split(".")
  let partsB = b.split(".")
  let len = Math.max(partsA.length, partsB.length)
  let i = 0
  while (i < len) {
    if (i >= partsA.length) return -1
    if (i >= partsB.length) return 1
    let pa = partsA[i]
    let pb = partsB[i]
    let numA = parseInt(pa)
    let numB = parseInt(pb)
    let aIsNum = !isNaN(numA) && String(numA) === pa
    let bIsNum = !isNaN(numB) && String(numB) === pb
    if (aIsNum && bIsNum) {
      if (numA < numB) return -1
      if (numA > numB) return 1
    } else if (aIsNum && !bIsNum) {
      return -1 // numeric < string
    } else if (!aIsNum && bIsNum) {
      return 1
    } else {
      if (pa < pb) return -1
      if (pa > pb) return 1
    }
    i = i + 1
  }
  return 0
}

export fn compare(a, b) {
  let pa = parse(a)
  let pb = parse(b)
  if (pa === null || pb === null) return null

  if (pa.major !== pb.major) return pa.major < pb.major ? -1 : 1
  if (pa.minor !== pb.minor) return pa.minor < pb.minor ? -1 : 1
  if (pa.patch !== pb.patch) return pa.patch < pb.patch ? -1 : 1

  return comparePrereleaseIdentifiers(pa.prerelease, pb.prerelease)
}

export fn gt(a, b) { return compare(a, b) === 1 }
export fn lt(a, b) { return compare(a, b) === -1 }
export fn gte(a, b) { let c = compare(a, b); return c === 0 || c === 1 }
export fn lte(a, b) { let c = compare(a, b); return c === 0 || c === -1 }
export fn eq(a, b) { return compare(a, b) === 0 }

export fn increment(version, releaseType, prereleaseId) {
  let p = parse(version)
  if (p === null) return null

  if (releaseType === "major") {
    p.major = p.major + 1
    p.minor = 0
    p.patch = 0
    p.prerelease = null
    p.build = null
  } else if (releaseType === "minor") {
    p.minor = p.minor + 1
    p.patch = 0
    p.prerelease = null
    p.build = null
  } else if (releaseType === "patch") {
    // If we have a prerelease, just drop it for patch
    if (p.prerelease !== null) {
      p.prerelease = null
      p.build = null
    } else {
      p.patch = p.patch + 1
      p.prerelease = null
      p.build = null
    }
  } else if (releaseType === "premajor") {
    p.major = p.major + 1
    p.minor = 0
    p.patch = 0
    let id = prereleaseId !== null ? prereleaseId : "0"
    p.prerelease = `${id}.0`
    p.build = null
  } else if (releaseType === "preminor") {
    p.minor = p.minor + 1
    p.patch = 0
    let id = prereleaseId !== null ? prereleaseId : "0"
    p.prerelease = `${id}.0`
    p.build = null
  } else if (releaseType === "prepatch") {
    p.patch = p.patch + 1
    let id = prereleaseId !== null ? prereleaseId : "0"
    p.prerelease = `${id}.0`
    p.build = null
  } else if (releaseType === "prerelease") {
    if (p.prerelease !== null) {
      // Increment the last numeric identifier
      let parts = p.prerelease.split(".")
      let lastIdx = parts.length - 1
      let lastNum = parseInt(parts[lastIdx])
      if (!isNaN(lastNum) && String(lastNum) === parts[lastIdx]) {
        parts[lastIdx] = String(lastNum + 1)
      } else {
        parts.push("0")
      }
      p.prerelease = parts.join(".")
    } else {
      p.patch = p.patch + 1
      let id = prereleaseId !== null ? prereleaseId : "0"
      p.prerelease = `${id}.0`
    }
    p.build = null
  } else {
    return null
  }

  return format(p)
}

// Determine if version satisfies a major.minor.x range
export fn satisfiesRange(version, range) {
  let p = parse(version)
  if (p === null) return false

  // Handle ">=x.y.z" ranges
  if (range.startsWith(">=")) {
    let rangeVer = range.slice(2).trim()
    return gte(version, rangeVer)
  }

  // Handle "x.y.x" maintenance branch ranges
  let parts = range.split(".")
  if (parts.length === 3) {
    if (parts[2] === "x") {
      let rangeMajor = parseInt(parts[0])
      let rangeMinor = parseInt(parts[1])
      return p.major === rangeMajor && p.minor === rangeMinor
    }
  }

  return eq(version, range)
}
