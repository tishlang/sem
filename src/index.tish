// sem/src/index.tish
// Library entry — dual-runtime API for Node (dist) and Tish consumers

import { loadConfig } from "./config.tish"
import { release } from "./orchestrator.tish"
import { writeGitHubOutputs } from "./github-output.tish"
import { enableDebug, log } from "./logger.tish"
import { getPackageVersion } from "./host.tish"

export { loadConfig, release, writeGitHubOutputs }

fn parseArgs(argv) {
  let args = {
    dryRun: false,
    noCi: false,
    debug: false,
    branch: null,
    cwd: null,
    configJson: null,
    force: null,
    ignoreBranches: null,
    githubOutput: false,
    help: false,
    version: false
  }

  let i = 0
  while (i < argv.length) {
    let arg = argv[i]

    if (arg === "--dry-run" || arg === "-d") {
      args.dryRun = true
    } else if (arg === "--no-ci") {
      args.noCi = true
    } else if (arg === "--debug") {
      args.debug = true
    } else if (arg === "--github-output") {
      args.githubOutput = true
    } else if (arg === "--force" || arg === "-f") {
      if (i + 1 < argv.length) {
        i = i + 1
        args.force = argv[i]
      }
    } else if (arg.startsWith("--force=")) {
      args.force = arg.slice("--force=".length)
    } else if (arg === "--ignore-branches") {
      if (i + 1 < argv.length) {
        i = i + 1
        args.ignoreBranches = argv[i]
      }
    } else if (arg === "--branch" || arg === "-b") {
      if (i + 1 < argv.length) {
        i = i + 1
        args.branch = argv[i]
      }
    } else if (arg === "--cwd") {
      if (i + 1 < argv.length) {
        i = i + 1
        args.cwd = argv[i]
      }
    } else if (arg === "--config-json") {
      if (i + 1 < argv.length) {
        i = i + 1
        args.configJson = argv[i]
      }
    } else if (arg === "--help" || arg === "-h") {
      args.help = true
    } else if (arg === "--version" || arg === "-v") {
      args.version = true
    }

    i = i + 1
  }

  return args
}

const HELP_TEXT = `
sem — automated semantic versioning and release pipeline

Usage:
  npm run release
  npm run release -- --force patch
  sem [options]

Options:
  --dry-run              Run without making any changes
  --no-ci                Skip CI environment check
  --debug                Enable debug logging
  --force <type|version> Force a release: major|minor|patch, or exact x.y.z
  --ignore-branches <list>  Comma-separated branch globs to soft-skip
  --branch <name>        Override the release branch
  --cwd <path>           Working directory (monorepo package root)
  --config-json <doc>    Inline config JSON or YAML (skips file / package.json config)
  --github-output        Write Action-compatible keys to $GITHUB_OUTPUT
  --help                 Show this help message
  --version              Show version

Environment:
  SEM_CONFIG             Inline config JSON or YAML (same as --config-json)
  SEM_FORCE              Same as --force (major|minor|patch|x.y.z)
  GITHUB_OUTPUT          Path written when --github-output or Action mode
  NPM_OTP                One-time password for npm 2FA publish

Configuration (when --config-json / SEM_CONFIG not set):
  1. .semrc.json
  2. .releaserc.json
  3. package.json "sem" or "release" key
  4. Built-in defaults
`

fn resolvePackageRoot() {
  if (process.env.SEM_PACKAGE_ROOT !== null && process.env.SEM_PACKAGE_ROOT !== "") {
    return process.env.SEM_PACKAGE_ROOT
  }

  // When running the Node CLI (`node dist/cli.js`), resolve package root from argv[1]
  if (typeof process.getBuiltinModule === "function" && process.argv.length > 1) {
    let pathMod = process.getBuiltinModule("path")
    let fs = process.getBuiltinModule("fs")
    if (pathMod !== null && fs !== null) {
      let script = pathMod.resolve(process.argv[1])
      let dir = pathMod.dirname(script)
      let candidate = pathMod.resolve(dir, "..")
      if (fs.existsSync(pathMod.join(candidate, "package.json"))) {
        return candidate
      }
      if (fs.existsSync(pathMod.join(dir, "package.json"))) {
        return dir
      }
    }
  }

  return process.cwd()
}

export async fn runCli(argv) {
  let args = parseArgs(argv !== null ? argv : process.argv.slice(2))

  if (args.help) {
    console.log(HELP_TEXT)
    process.exit(0)
    return { success: true, released: false }
  }

  let pkgCwd = resolvePackageRoot()
  let version = process.env.SEM_PACKAGE_VERSION !== null && process.env.SEM_PACKAGE_VERSION !== ""
    ? process.env.SEM_PACKAGE_VERSION
    : getPackageVersion(pkgCwd)

  if (args.version) {
    console.log(`sem v${version}`)
    process.exit(0)
    return { success: true, released: false }
  }

  if (args.debug) {
    enableDebug()
  }

  let cwd = args.cwd !== null ? args.cwd : process.cwd()
  let cliOverrides = {}

  if (args.dryRun) cliOverrides.dryRun = true
  if (args.noCi) cliOverrides.noCi = true
  if (args.debug) cliOverrides.debug = true
  if (args.configJson !== null) cliOverrides.configJson = args.configJson
  if (args.force !== null) cliOverrides.force = args.force
  if (args.ignoreBranches !== null && args.ignoreBranches !== "") {
    let parts = String(args.ignoreBranches).split(",")
    let list = []
    let pi = 0
    while (pi < parts.length) {
      let p = parts[pi].trim()
      if (p !== "") list.push(p)
      pi = pi + 1
    }
    cliOverrides.ignoreBranches = list
  }

  let config = loadConfig(cwd, cliOverrides)

  if (args.branch !== null) {
    let found = false
    let bi = 0
    while (bi < config.branches.length) {
      let b = config.branches[bi]
      let bName = typeof b === "string" ? b : b.name
      if (bName === args.branch) {
        found = true
        break
      }
      bi = bi + 1
    }
    if (!found) {
      config.branches.push(args.branch)
    }
  }

  let result = await release(config)

  let wantOutputs = args.githubOutput || (process.env.GITHUB_OUTPUT !== null && process.env.GITHUB_OUTPUT !== "")
  if (wantOutputs) {
    writeGitHubOutputs(result)
  }

  if (!result.success) {
    log.error(`Release failed: ${result.error}`)
    process.exit(1)
  } else if (result.released) {
    log.success(`Released v${result.version}`)
    process.exit(0)
  } else if (result.skipped === true) {
    log.info("Skipped: " + (result.reason !== null ? result.reason : "branch"))
    process.exit(0)
  } else {
    log.info("No release needed")
    process.exit(0)
  }

  return result
}
